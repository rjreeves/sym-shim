module sym

import Stdlib.Core
import Stdlib.Text
import Stdlib.File
import Stdlib.Path
import Stdlib.Env
import Stdlib.Collections
import Stdlib.Bytes
import Stdlib.Process
import Stdlib.Http
import Stdlib.Crypto
import AtomicWrite

fn fatal(msg: Text): Unit [io] = {
    eprintln("sym: " ++ msg)
    flush()
    Process.quit(1)
}

fn fatalText(msg: Text): Text [io] = {
    fatal(msg)
    ""
}

fn usageAndExit(): Unit [io] = {
    eprintln("usage:")
    eprintln("  sym install <package> <version> <source-file> [<command-filename>]")
    eprintln("  sym uninstall <package> <version>")
    eprintln("  sym shim add <name> <package> <version> [<command-filename>]")
    eprintln("  sym shim remove <name>")
    eprintln("  sym shim list")
    eprintln("  sym use <package> <version>")
    eprintln("  sym pin <tool> <version> [<dir>]")
    flush()
    Process.quit(1)
}

// Same `??`-avoidance rule as sym_shim.cto: `match` for any fallback with
// an [io] effect, since `??` evaluates its right-hand side unconditionally.
fn unwrapOrFatal(opt: Text?, msg: Text): Text [io] =
    match opt {
        Some(v) => v
        None => {
            fatal(msg)
            ""
        }
    }

fn stripQuotes(s: Text): Text =
    if Text.startsWith(s, "\"") and Text.endsWith(s, "\"") and Text.len(s) >= 2
    then Text.slice(s, 1, Text.len(s) - 1)
    else s

type KeyValue = { key: Text, value: Text }

fn parseKVLine(line: Text): KeyValue? = {
    let trimmed = Text.trim(line)
    if Text.len(trimmed) == 0 or Text.startsWith(trimmed, "#") then None
    else match Text.indexOf(trimmed, "=") {
        Some(eq) => Some(KeyValue {
            key: Text.trim(Text.slice(trimmed, 0, eq)),
            value: stripQuotes(Text.trim(Text.slice(trimmed, eq + 1, Text.len(trimmed))))
        })
        None => None
    }
}

fn findKeyIn(content: Text, wantedKey: Text): Text? = {
    var result: Text? = None
    for line in Text.split(content, "\n") {
        match parseKVLine(line) {
            Some(kv) => {
                if kv.key == wantedKey then { result = Some(kv.value) } else {}
            }
            None => {}
        }
    }
    result
}

type PkgVer = { package: Text, version: Text }

// package and version are separate arguments, not a "package@version"
// token -- some shells (confirmed: Ion-win) treat `@` followed by a digit
// as a variable-expansion sequence, silently mangling an embedded "@1.2.3"
// before this program ever sees it. Splitting into two plain arguments
// sidesteps the problem at the source rather than working around any one
// shell's expansion rules.
fn requirePkgVer(packageArg: Text?, versionArg: Text?, usage: Text): PkgVer [io] = {
    let package = unwrapOrFatal(packageArg, usage ++ ": missing <package>")
    let version = unwrapOrFatal(versionArg, usage ++ ": missing <version>")
    PkgVer { package: package, version: version }
}

fn symHome(): Text [io] =
    match getEnv("SYM_HOME") {
        Some(v) => v
        None => match getEnv("LOCALAPPDATA") {
            Some(v) => Path.join(v, "Sym")
            None => {
                fatal("neither SYM_HOME nor LOCALAPPDATA is set")
                ""
            }
        }
    }

// Writes via a same-directory temp file + rename rather than writeFile
// directly, so a sym_shim process reading this exact path never observes
// a partial write -- renameFile is atomic when both paths are on the same
// volume, which "path ++ .tmp" always is.
fn writeFileAtomic(path: Text, content: Text): Bool [io] = {
    let tempPath = path ++ ".tmp"
    let wrote = writeFile(tempPath, content)
    if !wrote then false
    else renameFile(tempPath, path)
}

fn writeDescriptor(path: Text, package: Text, command: Text, version: Text): Bool [io] =
    writeFileAtomic(path,
        "package = \"" ++ package ++ "\"\n" ++
        "command = \"" ++ command ++ "\"\n" ++
        "version = \"" ++ version ++ "\"\n"
    )

type Descriptor = { package: Text, command: Text, version: Text }

fn parseDescriptor(content: Text): Descriptor = {
    var package = ""
    var command = ""
    var version = ""
    for line in Text.split(content, "\n") {
        match parseKVLine(line) {
            Some(kv) => {
                match kv.key {
                    "package" => { package = kv.value }
                    "command" => { command = kv.value }
                    "version" => { version = kv.value }
                    _ => {}
                }
            }
            None => {}
        }
    }
    Descriptor { package: package, command: command, version: version }
}

// Rewrites `key`'s value if present (preserving every other line, including
// comments), or appends a new "key = value" line if absent.
fn upsertLine(content: Text, key: Text, value: Text): Text = {
    if Text.len(Text.trim(content)) == 0 then key ++ " = \"" ++ value ++ "\"\n"
    else {
        var found = false
        var result = ""
        for line in Text.split(content, "\n") {
            match parseKVLine(line) {
                Some(kv) => {
                    if kv.key == key then {
                        result = result ++ key ++ " = \"" ++ value ++ "\"\n"
                        found = true
                    } else {
                        result = result ++ line ++ "\n"
                    }
                }
                None => {
                    if Text.len(Text.trim(line)) == 0 then {}
                    else { result = result ++ line ++ "\n" }
                }
            }
        }
        if found then result else result ++ key ++ " = \"" ++ value ++ "\"\n"
    }
}

fn listTomlFiles(dir: Text): List<Text> = {
    var result: List<Text> = List.empty()
    match listDir(dir) {
        Some(entries) => {
            for e in entries {
                if Text.endsWith(e, ".toml") then { result = List.push(result, e) } else {}
            }
        }
        None => {}
    }
    result
}

// Reads sources\<package>.toml -- the per-package "how to fetch" config.
// `repo`/`tag`/`asset` are only used by the "github-release" provider;
// `url` only by the generic "url" provider -- see buildFetchUrl.
type SourceConfig = { provider: Text, repo: Text, tag: Text, asset: Text, url: Text, archive: Text, binaryPath: Text }

fn parseSourceConfig(content: Text): SourceConfig = {
    var provider = ""
    var repo = ""
    var tag = ""
    var asset = ""
    var url = ""
    var archive = "none"
    var binaryPath = ""
    for line in Text.split(content, "\n") {
        match parseKVLine(line) {
            Some(kv) => {
                match kv.key {
                    "provider" => { provider = kv.value }
                    "repo" => { repo = kv.value }
                    "tag" => { tag = kv.value }
                    "asset" => { asset = kv.value }
                    "url" => { url = kv.value }
                    "archive" => { archive = kv.value }
                    "binary_path" => { binaryPath = kv.value }
                    _ => {}
                }
            }
            None => {}
        }
    }
    SourceConfig { provider: provider, repo: repo, tag: tag, asset: asset, url: url, archive: archive, binaryPath: binaryPath }
}

// The only provider-specific step -- everything downstream (fetch,
// checksum, extract, place) is identical regardless of how the URL
// was built.
fn buildFetchUrl(cfg: SourceConfig, sourcePath: Text, version: Text): Text [io] =
    match cfg.provider {
        "github-release" => {
            if Text.len(cfg.repo) == 0 then fatalText("malformed " ++ sourcePath ++ " (missing repo)")
            else if Text.len(cfg.asset) == 0 then fatalText("malformed " ++ sourcePath ++ " (missing asset)")
            else {
                let tagTemplate = if Text.len(cfg.tag) == 0 then "{version}" else cfg.tag
                let tag = Text.replace(tagTemplate, "{version}", version)
                let asset = Text.replace(cfg.asset, "{version}", version)
                "https://github.com/" ++ cfg.repo ++ "/releases/download/" ++ tag ++ "/" ++ asset
            }
        }
        "url" => {
            if Text.len(cfg.url) == 0 then fatalText("malformed " ++ sourcePath ++ " (missing url)")
            else Text.replace(cfg.url, "{version}", version)
        }
        _ => fatalText("unsupported provider '" ++ cfg.provider ++ "' in " ++ sourcePath)
    }

// Verifies against a pinned per-version hash if one exists
// (sources\<package>\checksums.toml, a flat "<version> = <sha256-hex>"
// file -- reuses findKeyIn exactly as sym.toml does), and warns rather
// than silently skipping verification when there isn't one.
fn verifyChecksum(sourcesDir: Text, pv: PkgVer, downloaded: Bytes): Unit [io] = {
    let checksumsPath = Path.join(Path.join(sourcesDir, pv.package), "checksums.toml")
    match readFile(checksumsPath) {
        Some(content) => {
            match findKeyIn(content, pv.version) {
                Some(expected) => {
                    let actual = Bytes.toHex(Crypto.sha256Bytes(downloaded))
                    if Text.toLower(actual) == Text.toLower(expected) then {
                        println("checksum verified")
                    } else {
                        fatal(
                            "checksum mismatch for " ++ pv.package ++ "@" ++ pv.version ++
                            ": expected " ++ expected ++ ", got " ++ actual
                        )
                    }
                }
                None => println("warning: no pinned checksum for " ++ pv.package ++ "@" ++ pv.version ++ " -- download unverified")
            }
        }
        None => println("warning: no checksums file for '" ++ pv.package ++ "' -- download unverified")
    }
}

fn fetchInstall(home: Text, pv: PkgVer): Unit [io] = {
    let sourcesDir = Path.join(home, "sources")
    let sourcePath = Path.join(sourcesDir, pv.package ++ ".toml")
    let sourceContent = unwrapOrFatal(
        readFile(sourcePath),
        "no source config for '" ++ pv.package ++ "' (expected " ++ sourcePath ++
        ") -- can't fetch without one; pass a local file instead: sym install " ++
        pv.package ++ " " ++ pv.version ++ " <source-file>"
    )
    let cfg = parseSourceConfig(sourceContent)
    if Text.len(cfg.binaryPath) == 0 then fatal("malformed " ++ sourcePath ++ " (missing binary_path)") else {}

    let binaryPath = Text.replace(cfg.binaryPath, "{version}", pv.version)
    let url = buildFetchUrl(cfg, sourcePath, pv.version)
    println("fetching " ++ url)
    flush()

    let r = Http.get(url)
    if !HttpResponse.ok(r) then
        fatal("download failed: HTTP " ++ intToText(HttpResponse.status(r)) ++ " for " ++ url)
    else {}

    let downloaded = HttpResponse.bodyBytes(r)
    verifyChecksum(sourcesDir, pv, downloaded)

    let destDir = Path.join(Path.join(Path.join(home, "packages"), pv.package), pv.version)
    let madeDestDir = makeDir(destDir)
    if !madeDestDir then fatal("could not create " ++ destDir) else {}

    match cfg.archive {
        "none" => {
            let dest = Path.join(destDir, Path.basename(binaryPath))
            let wrote = writeBytesAtomic(dest, downloaded)
            if !wrote then fatal("failed to write " ++ dest) else {}
            println("installed " ++ pv.package ++ "@" ++ pv.version ++ " -> " ++ dest)
        }
        "tar" => {
            // One `tar -xf` handles zip, tar, tar.gz/tgz alike (verified
            // against real assets of each) -- no per-format branching needed.
            let tempDir = Path.join(home, "tmp")
            let madeTemp = makeDir(tempDir)
            if !madeTemp then fatal("could not create " ++ tempDir) else {}

            let tempArchive = Path.join(tempDir, pv.package ++ "-" ++ pv.version ++ ".archive")
            let wroteArchive = writeFileBytes(tempArchive, downloaded)
            if !wroteArchive then fatal("failed to write " ++ tempArchive) else {}

            let extractDir = Path.join(tempDir, pv.package ++ "-" ++ pv.version ++ "-extracted")
            let madeExtractDir = makeDir(extractDir)
            if !madeExtractDir then fatal("could not create " ++ extractDir) else {}

            flush()
            let code = Process.execInherit("tar", ["-xf", tempArchive, "-C", extractDir])
            if code != 0 then fatal("tar extraction failed with exit code " ++ intToText(code)) else {}

            let extractedFile = Path.join(extractDir, binaryPath)
            let dest = Path.join(destDir, Path.basename(binaryPath))
            let copied = copyBytes(extractedFile, dest)
            if !copied then
                fatal("extraction succeeded but could not find/copy '" ++ binaryPath ++ "' inside the archive (looked for " ++ extractedFile ++ ")")
            else {}

            // Best-effort cleanup -- the install already succeeded above,
            // so a failure here is silently ignored rather than fatal.
            let _ = deleteFile(tempArchive)
            let _ = removeDir(extractDir)
            println("installed " ++ pv.package ++ "@" ++ pv.version ++ " -> " ++ dest)
        }
        _ => fatal("unsupported archive type '" ++ cfg.archive ++ "' in " ++ sourcePath)
    }
}

fn cmdInstall(home: Text): Unit [io] = {
    let pv = requirePkgVer(arg(2), arg(3), "install")
    match arg(4) {
        Some(source) => {
            let commandName = arg(5) ?? Path.basename(source)

            let destDir = Path.join(Path.join(Path.join(home, "packages"), pv.package), pv.version)
            let madeDir = makeDir(destDir)
            if !madeDir then fatal("could not create " ++ destDir) else {}

            let dest = Path.join(destDir, commandName)
            let copied = copyBytes(source, dest)
            if !copied then fatal("failed to install: could not read '" ++ source ++ "' or write '" ++ dest ++ "'") else {}

            println("installed " ++ pv.package ++ "@" ++ pv.version ++ " -> " ++ dest)
        }
        None => fetchInstall(home, pv)
    }
}

fn cmdShimAdd(home: Text): Unit [io] = {
    let name = unwrapOrFatal(arg(3), "shim add: missing <name>")
    let pv = requirePkgVer(arg(4), arg(5), "shim add")
    let commandName = arg(6) ?? (name ++ ".exe")

    let binDir = Path.join(home, "bin")
    let madeBin = makeDir(binDir)
    if !madeBin then fatal("could not create " ++ binDir) else {}

    let masterShim = Path.join(Path.join(home, "shim"), "sym_shim.exe")
    let binPath = Path.join(binDir, name ++ ".exe")
    let copied = copyBytes(masterShim, binPath)
    if !copied then fatal("could not copy shim from '" ++ masterShim ++ "' -- is it built and in place?") else {}

    let shimsDir = Path.join(home, "shims")
    let madeShims = makeDir(shimsDir)
    if !madeShims then fatal("could not create " ++ shimsDir) else {}

    let descPath = Path.join(shimsDir, name ++ ".toml")
    let wrote = writeDescriptor(descPath, pv.package, commandName, pv.version)
    if !wrote then fatal("failed to write " ++ descPath) else {}

    println("shimmed '" ++ name ++ "' -> " ++ pv.package ++ "@" ++ pv.version ++ " (" ++ commandName ++ ")")
}

fn cmdShimRemove(home: Text): Unit [io] = {
    let name = unwrapOrFatal(arg(3), "shim remove: missing <name>")
    let binPath = Path.join(Path.join(home, "bin"), name ++ ".exe")
    let descPath = Path.join(Path.join(home, "shims"), name ++ ".toml")
    let removedBin = deleteFile(binPath)
    let removedDesc = deleteFile(descPath)
    println("removed '" ++ name ++ "' (bin: " ++ boolToText(removedBin) ++ ", descriptor: " ++ boolToText(removedDesc) ++ ")")
}

fn cmdShimList(home: Text): Unit [io] = {
    let shimsDir = Path.join(home, "shims")
    let files = listTomlFiles(shimsDir)
    if List.len(files) == 0 then println("(no shims)") else {}
    for f in files {
        let name = Path.stem(f)
        let content = unwrapOrFatal(readFile(Path.join(shimsDir, f)), "could not read " ++ f)
        let d = parseDescriptor(content)
        println(name ++ " -> " ++ d.package ++ "@" ++ d.version ++ " (" ++ d.command ++ ")")
    }
}

fn cmdUse(home: Text): Unit [io] = {
    let pv = requirePkgVer(arg(2), arg(3), "use")
    let shimsDir = Path.join(home, "shims")
    let files = listTomlFiles(shimsDir)
    var updated = 0
    for f in files {
        let path = Path.join(shimsDir, f)
        let content = unwrapOrFatal(readFile(path), "could not read " ++ path)
        let d = parseDescriptor(content)
        if d.package == pv.package then {
            let newContent = upsertLine(content, "version", pv.version)
            let ok = writeFileAtomic(path, newContent)
            if ok then { updated = updated + 1 } else {}
        } else {}
    }
    println("updated " ++ intToText(updated) ++ " shim(s) for " ++ pv.package ++ "@" ++ pv.version)
}

fn cmdPin(): Unit [io] = {
    let pv = requirePkgVer(arg(2), arg(3), "pin")
    let dir = match arg(4) {
        Some(d) => d
        None => getCurrentDir()
    }
    let path = Path.join(dir, "sym.toml")
    let existing = match readFile(path) {
        Some(c) => c
        None => ""
    }
    let newContent = upsertLine(existing, pv.package, pv.version)
    let ok = writeFileAtomic(path, newContent)
    if !ok then fatal("failed to write " ++ path) else {}
    println("pinned " ++ pv.package ++ " = " ++ pv.version ++ " in " ++ path)
}

// Removes packages\<package>\<version>\ outright, regardless of how many
// shimmed names' descriptors reference that package/version -- matching
// how `rm` doesn't care who else references a file. Shim descriptors
// pointing at a now-uninstalled version aren't touched; running that shim
// afterward hits the ordinary "is not installed" error already handled
// by sym_shim, the same as if the version had simply never been placed.
fn cmdUninstall(home: Text): Unit [io] = {
    let pv = requirePkgVer(arg(2), arg(3), "uninstall")
    let dir = Path.join(Path.join(Path.join(home, "packages"), pv.package), pv.version)
    match listDir(dir) {
        None => println(pv.package ++ "@" ++ pv.version ++ " is not installed (nothing to remove)")
        Some(_) => {
            let removed = removeDir(dir)
            if removed then println("uninstalled " ++ pv.package ++ "@" ++ pv.version ++ " (removed " ++ dir ++ ")")
            else fatal("failed to fully remove " ++ dir ++ " (check for files in use)")
        }
    }
}

fn main(): Unit [io] = {
    if argCount() < 2 then usageAndExit() else {}
    let cmd = unwrapOrFatal(arg(1), "internal error: missing command")

    match cmd {
        "install" => {
            let home = symHome()
            cmdInstall(home)
        }
        "uninstall" => {
            let home = symHome()
            cmdUninstall(home)
        }
        "use" => {
            let home = symHome()
            cmdUse(home)
        }
        "pin" => cmdPin()
        "shim" => {
            if argCount() < 3 then usageAndExit() else {}
            let home = symHome()
            let sub = unwrapOrFatal(arg(2), "internal error: missing shim subcommand")
            match sub {
                "add" => cmdShimAdd(home)
                "remove" => cmdShimRemove(home)
                "list" => cmdShimList(home)
                _ => usageAndExit()
            }
        }
        _ => usageAndExit()
    }
}
